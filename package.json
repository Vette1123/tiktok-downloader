{
  "name": "social-media-downloader",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node scripts/indexnow.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "icons": "node scripts/make-favicon.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "cf:build": "cross-env DEPLOY_TARGET=cloudflare next build && node scripts/cf-postbuild.mjs",
    "preview": "pnpm cf:build && wrangler dev",
    "deploy": "pnpm cf:build && wrangler deploy && node scripts/indexnow.mjs --force",
    "cf:startup": "node --experimental-vm-modules scripts/worker-startup.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:waf": "node scripts/cf-setup.mjs waf",
    "cf:health": "node scripts/cf-setup.mjs health"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "jszip": "^3.10.1",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "youtube-dl-exec": "^3.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
