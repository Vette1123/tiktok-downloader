{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-media-downloader-cn",

  // A small hand-written Worker, not a framework adapter. The site is a static
  // export served from `assets` below; this script only answers /api/*. See
  // cloudflare/worker.js for the reasoning.
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-01",

  // nodejs_compat: the extractors use node:* built-ins (node:stream,
  // node:crypto, node:buffer). Requires a compatibility_date >= 2024-09-23.
  //
  // global_fetch_strictly_public: makes fetch() from inside the Worker resolve
  // over the public internet instead of looping back into this same Worker.
  // Every extractor subrequest targets a third-party host, and the media
  // proxies can be handed a URL on our own domain — without this flag that
  // would re-enter the Worker and recurse.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // No per-version *.workers.dev preview URLs. `wrangler versions upload` hands
  // every uploaded version a public URL bound to the REAL D1 and the real
  // secrets — an unreleased build, reachable by anyone with the link, and a
  // second origin serving the same pages for search engines to find. Nothing
  // here needs them: previews happen locally via `pnpm preview`.
  "preview_urls": false,

  // esbuild's --keep-names emits a `__name(fn, "fn")` call per function, all of
  // which run at module scope — 186 of them here, measured at 0.4 ms of the
  // ~1 ms this Worker spends evaluating its global scope on every new isolate,
  // plus 8 KiB of bundle.
  //
  // It buys nothing in this build. The shim exists so that names survive
  // minification, and nothing minifies this bundle: all 171 function
  // declarations are still `function handleDownload(...)` in the emitted
  // worker.js, so stack traces in `wrangler tail` read exactly the same with it
  // off. Turn it back on if minify is ever enabled.
  "keep_names": false,

  "assets": {
    // `next build` with `output: 'export'` writes the whole site here: 12
    // pages, the 404 page, 28 generated PNGs (OpenGraph, Twitter, app icons),
    // robots.txt, sitemap.xml, the RSC payloads that make client-side
    // navigation work, and the hashed _next/static bundle.
    "directory": "out",
    "binding": "ASSETS",

    // Serve out/404.html (with a 404 status) for unmatched paths, instead of
    // the default bare "Not Found" text. The Worker reaches this via the
    // binding; the edge applies it directly when the Worker is not invoked.
    "not_found_handling": "404-page",

    // Static assets are matched before the Worker runs, which is exactly what
    // keeps page views off the CPU budget — but /api/* must never be answered
    // from the asset store, so those paths are pinned to the Worker. Nothing is
    // exported to out/api, so this is belt-and-braces rather than load-bearing.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // Native binaries can't run on workerd (no subprocesses, no writable FS), so
  // the yt-dlp / ffmpeg packages are aliased to a stub that throws on use. The
  // three routes that touch them already degrade gracefully (they were dead on
  // Vercel too, for the same reason). Aliasing keeps ~10 MB of unreachable
  // binaries and their dependency trees out of the Worker bundle.
  "alias": {
    "youtube-dl-exec": "./cloudflare/stubs/unavailable.js",
    "fluent-ffmpeg": "./cloudflare/stubs/unavailable.js",
    "@ffmpeg-installer/ffmpeg": "./cloudflare/stubs/unavailable.js"
  },

  // Only non-secret, runtime-read values belong here. NEXT_PUBLIC_SITE_URL is
  // deliberately absent: Next inlines NEXT_PUBLIC_* into the static HTML at
  // build time, so a Worker var would be read far too late — it is set as build
  // env in the deploy workflow instead.
  //
  // Secrets (WEB_USERNAME, WEB_PASSWORD, SESSION_SECRET, SHORTCUT_API_KEY,
  // IFPHP_API_KEY, COBALT_API_KEY, IG_SESSIONID, IG_CSRFTOKEN, IG_DS_USER_ID,
  // IG_MID, IG_DID, IG_DATR, IG_RUR, IG_WD, FB_COOKIE_HEADER, FB_DATR, FB_SB,
  // FB_C_USER, FB_XS, FB_FR, FB_WD, UPSTASH_REDIS_REST_URL,
  // UPSTASH_REDIS_REST_TOKEN, REGISTRY_KEY, COBALT_API_URL, PRO_TOKEN_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CREEM_API_KEY,
  // CREEM_WEBHOOK_SECRET, SCRAPE_UNLOCKER_URL) must NOT be listed here
  // — SCRAPE_UNLOCKER_URL carries an API key in its query string. This file is
  // committed. Set them with `wrangler secret put <NAME>` or in the dashboard.
  "vars": {
    // Signals to the extractors that native-binary paths (yt-dlp/ffmpeg) are
    // unavailable in this runtime, so they short-circuit instead of failing
    // slowly. See src/lib/nativeMedia.ts.
    "DEPLOY_TARGET": "cloudflare"
  }
}
