# ---------------------------------------------------------------------------
# The env file. There is exactly one.
#
# Copy this to `.env` and fill in what you need. That copy is gitignored
# (.gitignore `.env*`); this sample is the only version that is committed, so
# never put a real value here.
#
# Three tools read `.env`, which is why it is one file and not three:
#   - `next dev` / `next build` load it automatically
#   - `wrangler dev` loads it automatically, for local Worker runs
#   - `pnpm cf:setup secrets` uploads it to the deployed Worker as *secrets*
#     (encrypted at rest, invisible in the dashboard afterwards) — never into
#     wrangler.jsonc, which is committed
#
# Do NOT add a `.dev.vars` file. Wrangler prefers it and then ignores `.env`
# entirely, which splits local values away from deployed ones — the exact
# problem this single file exists to end.
#
# Three kinds of key are NOT uploaded (see `isLocalOnly` in
# scripts/cf-setup.mjs): `CLOUDFLARE_*` authenticate the tooling itself,
# `*_TEST` are test-store twins the Worker must never hold, and `NEXT_PUBLIC_*`
# are build-time values Next has already inlined by then.
#
# Blank values are skipped, not uploaded as empty strings. A secret already on
# the Worker is left untouched when its key is blank here.
# ---------------------------------------------------------------------------

# --- Cloudflare tooling credentials ---------------------------------------
# Local only. These authenticate cf-setup; they are never uploaded.

# Cloudflare API token. Create at:
#   https://dash.cloudflare.com/profile/api-tokens -> Create Token
# Start from the "Edit Cloudflare Workers" template, then ADD two permissions
# so the same token can also move the domain onto Cloudflare:
#
#   Account | Workers Scripts        | Edit    (from the template)
#   Account | Account Settings       | Read    (from the template)
#   Account | Workers Tail           | Read    (from the template; `wrangler tail`)
#   Zone    | Workers Routes         | Edit    (from the template)
#   Zone    | Zone                   | Edit    <- add (creates the zone)
#   Zone    | DNS                    | Edit    <- add (custom domain record)
#
#   Account Resources: Include -> <your account>
#   Zone Resources:    Include -> All zones from an account -> <your account>
#
# Leave the TTL unrestricted and the IP filter empty unless you have a static
# IP. Copy the token once — Cloudflare never shows it again.
CLOUDFLARE_API_TOKEN=

# Optional. Auto-discovered from the token when left blank (needs the
# "Account Settings: Read" permission above). Set it explicitly only if the
# token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=

# --- Build-time values ----------------------------------------------------
# NEXT_PUBLIC_* is inlined into the bundle by `next build` and reaches the
# browser. Never put a secret in one, and never expect setting one here to
# change a deployment that was already built.

# Public base URL of the deployed site — used for canonical URLs,
# OpenGraph/Twitter metadata, sitemap entries and JSON-LD. A trailing slash is
# stripped, so either form works. Leave unset locally to fall back to the
# production domain (https://www.socialdownloader.space).
NEXT_PUBLIC_SITE_URL=

# Cloudflare Web Analytics beacon token.
# Warning: if Web Analytics is already enabled at the ZONE level in the
# Cloudflare dashboard, the beacon is injected at the edge automatically and
# setting this too will double-count page views. Pick one mechanism.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Phase 3 display-ad switch. Set to '1' to swap the sponsor card for the ad
# scaffold. Runtime off-switch, not compile-time — both branches ship. Do NOT
# enable until a real ad unit is wired: today it renders an empty card.
NEXT_PUBLIC_ADS_ENABLED=

# --- Worker secrets -------------------------------------------------------
# Everything below is uploaded by `pnpm cf:setup secrets`, and read by the
# deployed site at runtime.

# Private web access. All four values are required; if one is missing, the
# resolver APIs fail closed. WEB_PASSWORD should be unique to this deployment.
WEB_USERNAME=
WEB_PASSWORD=

# Generate two DIFFERENT random strings of at least 32 characters. The first
# signs the HttpOnly browser session. The second is accepted only through the
# Authorization or X-API-Key request header for iOS Shortcuts/API clients.
# Never put either value in a URL query parameter or commit it to this file.
SESSION_SECRET=
SHORTCUT_API_KEY=

# Self-hosted cobalt instance(s) (media extractor/tunnel), comma- or
# space-separated. Used as a FALLBACK when the public community instance fails
# or rate-limits. See deploy/cobalt/ for a free Render deploy. Must include the
# trailing slash.
COBALT_API_URL=

# Only if your cobalt instance has API_AUTH_REQUIRED=1. Sent as
# `Authorization: Api-Key <key>`.
COBALT_API_KEY=

# Last-resort page fetch for sites that wall datacenter IPs (they answer a
# Worker with a ~369-byte redirect stub while a residential IP gets the real
# markup). The block is on datacenter ranges in general, so a VPS or a
# self-hosted extractor is walled the same way; only
# egress from a residential pool changes the answer, which means a third-party
# unlocker with an HTTPS API — Workers `fetch` cannot use an ordinary proxy.
#
# Any endpoint that returns the page's markup works. Put its request URL here
# with {url} where the target goes.
#
# Free: deploy/resolver serves exactly this at /html. Host it anywhere that is
# not Cloudflare — a free tier such as Koyeb or Back4app, or a machine at home
# behind a tunnel — and point this at it. See that README.
#   SCRAPE_UNLOCKER_URL=https://<resolver-host>/html?key=KEY&url={url}
#
# Or a paid unlocker, which is the same shape and bills per request:
#   SCRAPE_UNLOCKER_URL=https://api.provider.example/?api_key=KEY&url={url}
#
# NOTE (measured): the free relays built into the extractor — a reader service,
# the Internet Archive, and a public CORS proxy — all refuse requests coming
# from a Cloudflare Worker, though all three answer a residential connection.
# So this variable is what completes the blocked path, and it must point at
# something whose egress is NOT Cloudflare.
SCRAPE_UNLOCKER_URL=

# Per-host recipes for sites whose watch page is walled but whose embed is not.
# JSON array; see src/lib/siteRules.ts for the field meanings. Kept out of the
# repo deliberately — which hosts a deployment works around is not the public
# repository's business, and a host that changes its markup is repaired by
# editing this value instead of shipping a release.
#
#   [{"host":"www.site.example",
#     "id":"/video-([A-Za-z0-9]+)/",
#     "page":"https://www.site.example/embed/$1/",
#     "fid":"/thumbs/static\\d+/\\d+/\\d+/\\d+/(\\d+)/",
#     "media":"https://www.site.example/dload/$1/{h}/$2-{h}p.mp4",
#     "heights":[1080,720,480,360]}]
#
# Unset, no host behaves differently. It needs a working relay above to be
# reached at all, since the page it reads is itself behind the same block.
SCRAPE_SITE_RULES=

# Instagram `sessionid` cookie from a BURNER account. Only needed for
# login-gated posts; public reels/photos resolve without it.
#
# How to get it: log into instagram.com, open DevTools -> Application ->
# Cookies -> https://www.instagram.com, and copy the `sessionid` value (raw,
# %3A escapes are fine). Long-lived (~1y) but invalidated early by a logout, a
# password change, or the account being flagged.
#
# The Worker only attaches this secret to authenticated Instagram requests.
# It is never sent to the browser, a Cobalt service, another platform, logs or
# caches. Use a dedicated adult account instead of your primary account.
IG_SESSIONID=

# The companion cookies a real Instagram session carries. All optional, and
# all read from devtools > Application > Cookies on the browser that logged in
# — the same profile the IG_SESSIONID above came from.
#
# Why bother: a lone `sessionid` arriving from a datacenter IP is an anomaly on
# its own, because the real web client never sends one without these beside it.
# Filling them is the cheapest thing that extends how long a session survives
# before it is flagged. It does not make the session permanent; nothing does —
# the datacenter ASN is the dominant signal and no header changes it. Plan on
# rotating the session, and expect weeks rather than months.
#
# Mixing values from different browser profiles is worse than leaving them
# blank: a `mid` from one device beside a `sessionid` from another is a
# contradiction a single-device browser could never produce. An empty var is
# omitted from the header entirely rather than sent as `mid=`.
IG_CSRFTOKEN=
IG_DS_USER_ID=
IG_DID=
IG_MID=
IG_DATR=
IG_RUR=
# Viewport size, e.g. 1920x1080.
IG_WD=

# Upstash Redis REST credentials. Used to discover the self-hosted resolver's
# rotating Back4app URL (it self-registers on each /health ping).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the resolver presents when self-registering its live URL.
REGISTRY_KEY=

# HMAC key for Pro access tokens and session cookies (WebCrypto HMAC-SHA256).
# Generate 32+ random bytes yourself:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating this invalidates every issued token and session cookie at once —
# every signed-in user is forced to sign in again. Not something to do
# casually, and worth knowing that `cf:setup secrets` uploads whatever is here:
# if the deployed value was set by hand and differs from this one, that push
# IS the rotation.
PRO_TOKEN_SECRET=

# Google OAuth client, from console.cloud.google.com. Register BOTH redirect
# URIs on it: http://localhost:8787/api/auth/callback (wrangler dev) and
# https://<your-domain>/api/auth/callback.
#
# Moving to a client in a DIFFERENT Google Cloud project changes every existing
# user's `sub`, because a `sub` identifies a person within one project rather
# than globally. handleAuthCallback re-keys the account row by verified email
# so nobody is orphaned — but the new project's consent screen has to be
# published, since one left in Testing admits only its listed test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Bounds the token exchange with Google, in ms (default 10000). Only
# useful for telling a slow network apart from a broken exchange; production
# leaves it unset.
OAUTH_TIMEOUT_MS=

# Creem. The API key is required: customer-portal URLs are minted per click
# rather than stored, and the same key backs the subscription reconcile.
#
# A `creem_test_…` key is routed to Creem's test host automatically, so test
# and live mode differ by this one value and nothing else.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# The test-store twins, for driving Creem's test mode from a terminal. Local
# only — cf-setup refuses to upload any key ending in `_TEST`, because the
# Worker reads CREEM_API_KEY and a second live-adjacent credential in the
# deployment would only make "which store is this pointed at" ambiguous.
CREEM_API_KEY_TEST=
CREEM_WEBHOOK_SECRET_TEST=

# Buy Me a Coffee. The signing secret of the webhook endpoint, from
# Dashboard -> Integrations -> Webhooks -> the endpoint pointed at
# /api/billing/bmc. One secret per endpoint, so a second project's endpoint has
# a different one — never reuse this value across projects.
#
# Until it is set, /api/billing/bmc answers 503 and grants nothing. It is never
# optional while the route is registered: an unverified webhook endpoint lets
# anyone hand themselves the supporter extras. Setup: docs/buymeacoffee-setup.md.
BMC_WEBHOOK_SECRET=
